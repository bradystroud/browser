<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Chromium needs all three of these under the hardened runtime, in
	     every process that hosts V8 or loads the CEF framework, which is
	     all of them. That includes the generic helper hosting the network
	     service (browser-196): ad-hoc signing ignores entitlements
	     entirely, so a thinner set appeared to work until the daily build
	     began signing with a real Developer ID identity, at which point the
	     network service failed to start and every http/https navigation
	     hung forever with no error shown. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- The hardened runtime blocks Location Services unless the app
	     declares it; WebKit's geolocation runs its CLLocationManager in this
	     process, and without the key a site's location request fails even
	     after the user allows it. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
